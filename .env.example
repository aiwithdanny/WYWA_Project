# ═══════════════════════════════════════════════════════════════
# WYWA OFFICIAL WEBSITE - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════
# Backend vars live in backend/.env  |  Frontend vars live in frontend/.env

# ═══ DATABASE ═══
DATABASE_URL="postgresql://username:password@localhost:5432/wywa?schema=public"
# Use Neon.tech PostgreSQL connection string

# ═══ JWT AUTH ═══
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars-long"
JWT_EXPIRES_IN="7d"

# ═══ FRONTEND URL ═══
FRONTEND_URL="http://localhost:3000"
# Production: https://yourdomain.com

# ═══ EMAIL (SendGrid + Nodemailer) ═══
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@wywa.org.pk"
EMAIL_HOST="smtp.sendgrid.net"
EMAIL_PORT=587
EMAIL_USER="apikey"
EMAIL_PASS="your-sendgrid-api-key"

# ═══ FILE STORAGE (Cloudinary) ═══
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ═══ ADMIN (seed) ═══
ADMIN_EMAIL="admin@wywa.org.pk"
ADMIN_PASSWORD="change-this-default-password-in-production"

# ═══ MISC ═══
GOOGLE_MAPS_API_KEY="your-google-maps-key"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ═══ RATE LIMITING ═══
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Production only:
# NODE_ENV=production
