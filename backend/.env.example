# Backend environment variables
# Copy this file to .env and fill values.

# Neon (PostgreSQL) connection string.
# Example format:
# postgresql://USER:PASSWORD@ep-something-1234567.us-east-2.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=""

# Server — must match NEXT_PUBLIC_API_URL in frontend/.env
PORT=8000
NODE_ENV=development

# CORS / Frontend URL
CORS_ORIGIN="http://localhost:3000"

# JWT (used by admin routes) — required in production, no fallback
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# NextAuth secret (if shared with frontend) (optional)
NEXTAUTH_SECRET=""

# Email (Nodemailer + SendGrid)
SENDGRID_API_KEY=""
MAIL_FROM="WYWA <no-reply@wywa.org>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
